{
  "pageMeta": {
    "title": "批次计划管理",
    "description": "管理危化品运输批次计划，支持计划提报、审批、执行跟踪"
  },
  "searchConfig": {
    "items": [
      {
        "key": "dateRange",
        "label": "计划日期",
        "type": "dateRange",
        "placeholder": "请选择日期范围"
      },
      {
        "key": "status",
        "label": "计划状态",
        "type": "select",
        "placeholder": "请选择状态",
        "options": [
          { "label": "待审批", "value": "pending" },
          { "label": "已通过", "value": "approved" },
          { "label": "已驳回", "value": "rejected" },
          { "label": "派车中", "value": "dispatching" },
          { "label": "派车完成", "value": "dispatch_completed" },
          { "label": "已取消", "value": "cancelled" }
        ]
      },
      {
        "key": "cargoName",
        "label": "货物名称",
        "type": "input",
        "placeholder": "请输入货物名称"
      },
      {
        "key": "carrierName",
        "label": "承运企业",
        "type": "input",
        "placeholder": "请输入承运企业"
      }
    ]
  },
  "tableConfig": {
    "rowKey": "id",
    "columns": [
      {
        "key": "planNo",
        "title": "批次计划编号",
        "type": "text",
        "width": 150
      },
      {
        "key": "planDate",
        "title": "计划日期",
        "type": "text",
        "width": 120
      },
      {
        "key": "timeSlot",
        "title": "时间段",
        "type": "text",
        "width": 120
      },
      {
        "key": "shipperName",
        "title": "托运企业",
        "type": "text",
        "width": 150
      },
      {
        "key": "carrierName",
        "title": "承运企业",
        "type": "text",
        "width": 150
      },
      {
        "key": "cargoName",
        "title": "货物名称",
        "type": "text",
        "width": 120
      },
      {
        "key": "vehicleCount",
        "title": "总车数",
        "type": "text",
        "width": 80,
        "align": "center"
      },
      {
        "key": "dispatchedCount",
        "title": "已派车数",
        "type": "text",
        "width": 80,
        "align": "center"
      },
      {
        "key": "status",
        "title": "状态",
        "type": "tag",
        "width": 100,
        "dictKey": "planStatus"
      },
      {
        "key": "createTime",
        "title": "创建时间",
        "type": "text",
        "width": 150
      },
      {
        "key": "actions",
        "title": "操作",
        "type": "actions",
        "width": 200,
        "fixed": "right"
      }
    ],
    "dicts": {
      "planStatus": {
        "pending": { "label": "待审批", "color": "orange", "variant": "filled" },
        "approved": { "label": "已通过", "color": "green", "variant": "filled" },
        "rejected": { "label": "已驳回", "color": "red", "variant": "filled" },
        "dispatching": { "label": "派车中", "color": "blue", "variant": "filled" },
        "dispatch_completed": { "label": "派车完成", "color": "green", "variant": "filled" },
        "cancelled": { "label": "已取消", "color": "gray", "variant": "filled" },
        "draft": { "label": "草稿", "color": "default", "variant": "filled" }
      }
    }
  },
